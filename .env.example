# Copy to .env and fill in. `.env` itself is gitignored.

# Required. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Comma-separated DAV (CalDAV/CardDAV) server hostnames this app may connect
# to (e.g. caldav.example.com,192.168.1.50). Hostnames only: no scheme, port or
# path. Unset = any host allowed.
ALLOWED_DAV_HOSTS=

# Optional. Fixed DAV server URL. When set, the login page hides the Server URL
# field and every login uses this server. Unlike ALLOWED_DAV_HOSTS this is a
# full URL: the scheme (https:// or http://) is required, and a port or path
# may be included (e.g. https://dav.example.com:8443/dav). If ALLOWED_DAV_HOSTS
# is also set, this URL's hostname must be listed there; when this is set the
# allowlist is otherwise redundant.
DAV_SERVER_URL=

# Optional. How long a login lasts, in days. Default 1 (24h).
SESSION_TTL_DAYS=1

# Optional. See AGENTS.md's "SQLite read-cache" section.
CACHE_ENABLED=false
CACHE_SYNC_TTL_MS=30000

# Optional. Set to true when running behind a reverse proxy, so login rate
# limiting sees the real client IP (X-Forwarded-For) instead of the proxy's.
# Leave false when exposed directly: the header is spoofable.
TRUST_PROXY=false

# Optional. Max login attempts per client IP per minute. Default 10.
LOGIN_RATE_LIMIT_MAX=10

# Optional. Timeout, in ms, for any single outbound request (DAV server or
# subscription feed). Default 30000.
OUTBOUND_TIMEOUT_MS=30000
